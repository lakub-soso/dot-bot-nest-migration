{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/dot-bot/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/dot-bot/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/dot-bot",
  "projects": {
    "dot-bot": {
      "type": "application",
      "root": "apps/dot-bot",
      "entryFile": "main",
      "sourceRoot": "apps/dot-bot/src",
      "compilerOptions": {
        "tsConfigPath": "apps/dot-bot/tsconfig.app.json"
      }
    },
    "http-server": {
      "type": "application",
      "root": "apps/http-server",
      "entryFile": "main",
      "sourceRoot": "apps/http-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/http-server/tsconfig.app.json"
      }
    }
  }
}