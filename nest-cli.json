{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "apps/dot-bot/src",
    "compilerOptions": {
        "deleteOutDir": true,
        "webpack": false,
        "tsConfigPath": "apps/dot-bot/tsconfig.app.json"
    },
    "monorepo": true,
    "root": "apps/dot-bot",
    "projects": {
        "dot-bot": {
            "type": "application",
            "root": "apps/dot-bot",
            "entryFile": "main",
            "sourceRoot": "apps/dot-bot/src",
            "compilerOptions": {
                "tsConfigPath": "apps/dot-bot/tsconfig.app.json"
            }
        },
        "http-server": {
            "type": "application",
            "root": "apps/http-server",
            "entryFile": "main",
            "sourceRoot": "apps/http-server/src",
            "compilerOptions": {
                "tsConfigPath": "apps/http-server/tsconfig.app.json"
            }
        },
        "config": {
            "type": "library",
            "root": "libs/config",
            "entryFile": "index",
            "sourceRoot": "libs/config/src",
            "compilerOptions": {
                "tsConfigPath": "libs/config/tsconfig.lib.json"
            }
        },
        "database": {
            "type": "library",
            "root": "libs/database",
            "entryFile": "index",
            "sourceRoot": "libs/database/src",
            "compilerOptions": {
                "tsConfigPath": "libs/database/tsconfig.lib.json"
            }
        },
        "redis": {
            "type": "library",
            "root": "libs/redis",
            "entryFile": "index",
            "sourceRoot": "libs/redis/src",
            "compilerOptions": {
                "tsConfigPath": "libs/redis/tsconfig.lib.json"
            }
        },
        "common": {
            "type": "library",
            "root": "libs/common",
            "entryFile": "index",
            "sourceRoot": "libs/common/src",
            "compilerOptions": {
                "tsConfigPath": "libs/common/tsconfig.lib.json"
            }
        }
    }
}